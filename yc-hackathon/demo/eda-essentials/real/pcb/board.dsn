      (outline (path signal 50  -2800 2800  2800 2800  2800 -2800  -2800 -2800  -2800 2800))
      (pin MH_3200 "1" 0 0)
    )
    (padstack BGA_450
      (shape (circle F.Cu 450))
      (attach off)
    )
    (padstack R0402
      (shape (rect F.Cu -300 -300 300 300))
      (attach off)
    )
    (padstack R0603
      (shape (rect F.Cu -450 -475 450 475))
      (attach off)
    )
    (padstack OSC
      (shape (rect F.Cu -550 -450 550 450))
      (attach off)
    )
    (padstack USB
      (shape (rect F.Cu -675 -200 675 200))
      (attach off)
    )
    (padstack SOT_PIN
      (shape (rect F.Cu -500 -800 500 800))
      (attach off)
    )
    (padstack SOT_TAB
      (shape (rect F.Cu -1650 -800 1650 800))
      (attach off)
    )
    (padstack TH_1700
      (shape (circle F.Cu 1700))
      (shape (circle B.Cu 1700))
      (attach off)
    )
    (padstack TH_SQ
      (shape (rect F.Cu -850 -850 850 850))
      (shape (rect B.Cu -850 -850 850 850))
      (attach off)
    )
    (padstack MH_3200
      (shape (circle F.Cu 5600))
      (shape (circle B.Cu 5600))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net "LED0"
      (pins U1-H1 R1-1)
    )
    (net "/led_a0"
      (pins R1-2 D1-2)
    )
    (net "LED1"
      (pins U1-H2 R2-1)
    )
    (net "/led_a1"
      (pins R2-2 D2-2)
    )
    (net "LED2"
      (pins U1-H3 R3-1)
    )
    (net "/led_a2"
      (pins R3-2 D3-2)
    )
    (net "LED3"
      (pins U1-H4 R4-1)
    )
    (net "/led_a3"
      (pins R4-2 D4-2)
    )
    (net "LED4"
      (pins U1-H5 R5-1)
    )
    (net "/led_a4"
      (pins R5-2 D5-2)
    )
    (net "LED5"
      (pins U1-H6 R6-1)
    )
    (net "/led_a5"
      (pins R6-2 D6-2)
    )
    (net "LED6"
      (pins U1-H7 R7-1)
    )
    (net "/led_a6"
      (pins R7-2 D7-2)
    )
    (net "LED7"
      (pins U1-H8 R8-1)
    )
    (net "/led_a7"
      (pins R8-2 D8-2)
    )
    (net "CLK25"
      (pins U1-B1 Y1-3)
    )
    (net "TCK"
      (pins U1-B8 J1-3)
    )
    (net "TDI"
      (pins U1-C8 J1-4)
    )
    (net "TMS"
      (pins U1-D8 J1-5)
    )
    (net "TDO"
      (pins U1-E8 J1-6)
    )
    (net "RST"
      (pins U1-F8 J1-7)
    )
    (net "USB_DN"
      (pins U1-E1 J2-2)
    )
    (net "USB_DP"
      (pins U1-F1 J2-3)
    )
    (net "VBUS"
      (pins J2-1 U2-3)
    )
    (net "+3V3"
      (pins U1-C3 U1-C6 U1-F3 U1-F6 Y1-4 Y1-1 U2-2 U2-4 J1-1 C1-1 C2-1 C3-1 C4-1)
    )
    (net "GND"
      (pins U1-D4 U1-D5 U1-E4 U1-E5 Y1-2 J2-5 U2-1 J1-2 J1-8 J1-10 C1-2 C2-2 C3-2 C4-2 D1-1 D2-1 D3-1 D4-1 D5-1 D6-1 D7-1 D8-1)
    )
    (class kicad_default "" "LED0" "/led_a0" "LED1" "/led_a1" "LED2" "/led_a2" "LED3" "/led_a3" "LED4" "/led_a4" "LED5" "/led_a5" "LED6" "/led_a6" "LED7" "/led_a7" "CLK25" "TCK" "TDI" "TMS" "TDO" "RST" "USB_DN" "USB_DP" "VBUS" "+3V3" "GND"
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 200) (clearance 150))
    )
  )
  (wiring
  )
)
