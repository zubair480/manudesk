      (place U1 28000 -15000 front 0 (PN "LFE5U-25F-6BG256C"))
    )
    (component "Oscillator:Oscillator_SMD_3225-4Pin::Y1"
      (place Y1 15000 -10000 front 0 (PN "25MHz"))
    )
    (component "Capacitor_SMD:C_0402::C1"
      (place C1 20500 -9500 front 0 (PN "100nF"))
    )
    (component "Capacitor_SMD:C_0402::C2"
      (place C2 35500 -9500 front 0 (PN "100nF"))
    )
    (component "Capacitor_SMD:C_0402::C3"
      (place C3 20500 -21000 front 0 (PN "100nF"))
    )
    (component "Capacitor_SMD:C_0402::C4"
      (place C4 35500 -21000 front 0 (PN "100nF"))
    )
    (component "Resistor_SMD:R_0402::R1"
      (place R1 14000 -25500 front 0 (PN "330R"))
    )
    (component "LED_SMD:LED_0603::D1"
      (place D1 14000 -30500 front 0 (PN "LED_Green"))
    )
    (component "Resistor_SMD:R_0402::R2"
      (place R2 18000 -25500 front 0 (PN "330R"))
    )
    (component "LED_SMD:LED_0603::D2"
      (place D2 18000 -30500 front 0 (PN "LED_Green"))
    )
    (component "Resistor_SMD:R_0402::R3"
      (place R3 22000 -25500 front 0 (PN "330R"))
    )
    (component "LED_SMD:LED_0603::D3"
      (place D3 22000 -30500 front 0 (PN "LED_Green"))
    )
    (component "Resistor_SMD:R_0402::R4"
      (place R4 26000 -25500 front 0 (PN "330R"))
    )
    (component "LED_SMD:LED_0603::D4"
      (place D4 26000 -30500 front 0 (PN "LED_Green"))
    )
    (component "Resistor_SMD:R_0402::R5"
      (place R5 30000 -25500 front 0 (PN "330R"))
    )
    (component "LED_SMD:LED_0603::D5"
      (place D5 30000 -30500 front 0 (PN "LED_Green"))
    )
    (component "Resistor_SMD:R_0402::R6"
      (place R6 34000 -25500 front 0 (PN "330R"))
    )
    (component "LED_SMD:LED_0603::D6"
      (place D6 34000 -30500 front 0 (PN "LED_Green"))
    )
    (component "Resistor_SMD:R_0402::R7"
      (place R7 38000 -25500 front 0 (PN "330R"))
    )
    (component "LED_SMD:LED_0603::D7"
      (place D7 38000 -30500 front 0 (PN "LED_Green"))
    )
    (component "Resistor_SMD:R_0402::R8"
      (place R8 42000 -25500 front 0 (PN "330R"))
    )
    (component "LED_SMD:LED_0603::D8"
      (place D8 42000 -30500 front 0 (PN "LED_Green"))
    )
    (component "Connector_PinHeader_2.54mm:PinHeader_2x05::J1"
      (place J1 48770 -15080 front 0 (PN "JTAG"))
    )
    (component "Connector_USB:USB_Micro-B::J2"
      (place J2 3400 -19000 front 0 (PN "USB_Micro-B"))
    )
    (component "Package_TO_SOT_SMD:SOT-223::U2"
      (place U2 9000 -28000 front 0 (PN "AMS1117-3.3"))
    )
    (component "MountingHole:MountingHole_3.2mm_M3_Pad::H1"
      (place H1 3500 -3500 front 0 (PN "MountingHole_3.2mm"))
    )
    (component "MountingHole:MountingHole_3.2mm_M3_Pad::H2"
      (place H2 52500 -3500 front 0 (PN "MountingHole_3.2mm"))
    )
    (component "MountingHole:MountingHole_3.2mm_M3_Pad::H3"
      (place H3 3500 -34500 front 0 (PN "MountingHole_3.2mm"))
    )
    (component "MountingHole:MountingHole_3.2mm_M3_Pad::H4"
      (place H4 52500 -34500 front 0 (PN "MountingHole_3.2mm"))
    )
  )
  (library
    (image "Package_BGA:ECP5_CABGA256::U1"
      (outline (path signal 50  -5000 5000  5000 5000  5000 -5000  -5000 -5000  -5000 5000))
      (pin BGA_450 "A1" -3500 3500)
      (pin BGA_450 "A2" -2500 3500)
      (pin BGA_450 "A3" -1500 3500)
      (pin BGA_450 "A4" -500 3500)
      (pin BGA_450 "A5" 500 3500)
      (pin BGA_450 "A6" 1500 3500)
      (pin BGA_450 "A7" 2500 3500)
      (pin BGA_450 "A8" 3500 3500)
      (pin BGA_450 "B1" -3500 2500)
      (pin BGA_450 "B2" -2500 2500)
      (pin BGA_450 "B3" -1500 2500)
      (pin BGA_450 "B4" -500 2500)
      (pin BGA_450 "B5" 500 2500)
      (pin BGA_450 "B6" 1500 2500)
      (pin BGA_450 "B7" 2500 2500)
      (pin BGA_450 "B8" 3500 2500)
      (pin BGA_450 "C1" -3500 1500)
      (pin BGA_450 "C2" -2500 1500)
      (pin BGA_450 "C3" -1500 1500)
      (pin BGA_450 "C4" -500 1500)
      (pin BGA_450 "C5" 500 1500)
      (pin BGA_450 "C6" 1500 1500)
      (pin BGA_450 "C7" 2500 1500)
      (pin BGA_450 "C8" 3500 1500)
      (pin BGA_450 "D1" -3500 500)
      (pin BGA_450 "D2" -2500 500)
      (pin BGA_450 "D3" -1500 500)
      (pin BGA_450 "D4" -500 500)
      (pin BGA_450 "D5" 500 500)
      (pin BGA_450 "D6" 1500 500)
      (pin BGA_450 "D7" 2500 500)
      (pin BGA_450 "D8" 3500 500)
      (pin BGA_450 "E1" -3500 -500)
      (pin BGA_450 "E2" -2500 -500)
      (pin BGA_450 "E3" -1500 -500)
      (pin BGA_450 "E4" -500 -500)
      (pin BGA_450 "E5" 500 -500)
      (pin BGA_450 "E6" 1500 -500)
      (pin BGA_450 "E7" 2500 -500)
      (pin BGA_450 "E8" 3500 -500)
      (pin BGA_450 "F1" -3500 -1500)
      (pin BGA_450 "F2" -2500 -1500)
      (pin BGA_450 "F3" -1500 -1500)
      (pin BGA_450 "F4" -500 -1500)
      (pin BGA_450 "F5" 500 -1500)
      (pin BGA_450 "F6" 1500 -1500)
      (pin BGA_450 "F7" 2500 -1500)
      (pin BGA_450 "F8" 3500 -1500)
      (pin BGA_450 "G1" -3500 -2500)
      (pin BGA_450 "G2" -2500 -2500)
      (pin BGA_450 "G3" -1500 -2500)
      (pin BGA_450 "G4" -500 -2500)
      (pin BGA_450 "G5" 500 -2500)
      (pin BGA_450 "G6" 1500 -2500)
      (pin BGA_450 "G7" 2500 -2500)
      (pin BGA_450 "G8" 3500 -2500)
      (pin BGA_450 "H1" -3500 -3500)
      (pin BGA_450 "H2" -2500 -3500)
      (pin BGA_450 "H3" -1500 -3500)
      (pin BGA_450 "H4" -500 -3500)
      (pin BGA_450 "H5" 500 -3500)
      (pin BGA_450 "H6" 1500 -3500)
      (pin BGA_450 "H7" 2500 -3500)
      (pin BGA_450 "H8" 3500 -3500)
    )
    (image "Oscillator:Oscillator_SMD_3225-4Pin::Y1"
      (outline (path signal 50  -1600 1250  1600 1250  1600 -1250  -1600 -1250  -1600 1250))
      (pin OSC "1" -1100 -850)
      (pin OSC "2" 1100 -850)
      (pin OSC "3" 1100 850)
      (pin OSC "4" -1100 850)
    )
    (image "Capacitor_SMD:C_0402::C1"
      (outline (path signal 50  -500 250  500 250  500 -250  -500 -250  -500 250))
      (pin R0402 "1" -500 0)
      (pin R0402 "2" 500 0)
    )
    (image "Capacitor_SMD:C_0402::C2"
      (outline (path signal 50  -500 250  500 250  500 -250  -500 -250  -500 250))
      (pin R0402 "1" -500 0)
      (pin R0402 "2" 500 0)
    )
    (image "Capacitor_SMD:C_0402::C3"
      (outline (path signal 50  -500 250  500 250  500 -250  -500 -250  -500 250))
      (pin R0402 "1" -500 0)
      (pin R0402 "2" 500 0)
    )
    (image "Capacitor_SMD:C_0402::C4"
      (outline (path signal 50  -500 250  500 250  500 -250  -500 -250  -500 250))
      (pin R0402 "1" -500 0)
      (pin R0402 "2" 500 0)
    )
    (image "Resistor_SMD:R_0402::R1"
      (outline (path signal 50  -250 500  250 500  250 -500  -250 -500  -250 500))
      (pin R0402 "1" 0 500)
      (pin R0402 "2" 0 -500)
    )
    (image "LED_SMD:LED_0603::D1"
      (outline (path signal 50  -400 800  400 800  400 -800  -400 -800  -400 800))
      (pin R0603 "1" 0 -800)
      (pin R0603 "2" 0 800)
    )
    (image "Resistor_SMD:R_0402::R2"
      (outline (path signal 50  -250 500  250 500  250 -500  -250 -500  -250 500))
      (pin R0402 "1" 0 500)
      (pin R0402 "2" 0 -500)
    )
    (image "LED_SMD:LED_0603::D2"
