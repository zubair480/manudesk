      (pin R0603 "1" 0 -800)
      (pin R0603 "2" 0 800)
    )
    (image "Resistor_SMD:R_0402::R3"
      (outline (path signal 50  -250 500  250 500  250 -500  -250 -500  -250 500))
      (pin R0402 "1" 0 500)
      (pin R0402 "2" 0 -500)
    )
    (image "LED_SMD:LED_0603::D3"
      (outline (path signal 50  -400 800  400 800  400 -800  -400 -800  -400 800))
      (pin R0603 "1" 0 -800)
      (pin R0603 "2" 0 800)
    )
    (image "Resistor_SMD:R_0402::R4"
      (outline (path signal 50  -250 500  250 500  250 -500  -250 -500  -250 500))
      (pin R0402 "1" 0 500)
      (pin R0402 "2" 0 -500)
    )
    (image "LED_SMD:LED_0603::D4"
      (outline (path signal 50  -400 800  400 800  400 -800  -400 -800  -400 800))
      (pin R0603 "1" 0 -800)
      (pin R0603 "2" 0 800)
    )
    (image "Resistor_SMD:R_0402::R5"
      (outline (path signal 50  -250 500  250 500  250 -500  -250 -500  -250 500))
      (pin R0402 "1" 0 500)
      (pin R0402 "2" 0 -500)
