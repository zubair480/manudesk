      (pin R0603 "2" 0 800)
    )
    (image "Resistor_SMD:R_0402::R6"
      (outline (path signal 50  -250 500  250 500  250 -500  -250 -500  -250 500))
      (pin R0402 "1" 0 500)
      (pin R0402 "2" 0 -500)
    )
    (image "LED_SMD:LED_0603::D6"
      (outline (path signal 50  -400 800  400 800  400 -800  -400 -800  -400 800))
      (pin R0603 "1" 0 -800)
      (pin R0603 "2" 0 800)
    )
    (image "Resistor_SMD:R_0402::R7"
      (outline (path signal 50  -250 500  250 500  250 -500  -250 -500  -250 500))
      (pin R0402 "1" 0 500)
      (pin R0402 "2" 0 -500)
    )
    (image "LED_SMD:LED_0603::D7"
      (outline (path signal 50  -400 800  400 800  400 -800  -400 -800  -400 800))
      (pin R0603 "1" 0 -800)
      (pin R0603 "2" 0 800)
    )
    (image "Resistor_SMD:R_0402::R8"
      (outline (path signal 50  -250 500  250 500  250 -500  -250 -500  -250 500))
      (pin R0402 "1" 0 500)
      (pin R0402 "2" 0 -500)
    )
    (image "LED_SMD:LED_0603::D8"
      (outline (path signal 50  -400 800  400 800  400 -800  -400 -800  -400 800))
      (pin R0603 "1" 0 -800)
      (pin R0603 "2" 0 800)
    )
    (image "Connector_PinHeader_2.54mm:PinHeader_2x05::J1"
      (outline (path signal 50  -2540 6350  2540 6350  2540 -6350  -2540 -6350  -2540 6350))
      (pin TH_SQ "1" -1270 5080)
      (pin TH_1700 "2" 1270 5080)
      (pin TH_1700 "3" -1270 2540)
      (pin TH_1700 "4" 1270 2540)
      (pin TH_1700 "5" -1270 0)
      (pin TH_1700 "6" 1270 0)
      (pin TH_1700 "7" -1270 -2540)
      (pin TH_1700 "8" 1270 -2540)
      (pin TH_1700 "9" -1270 -5080)
      (pin TH_1700 "10" 1270 -5080)
    )
    (image "Connector_USB:USB_Micro-B::J2"
      (outline (path signal 50  -2500 3750  2500 3750  2500 -3750  -2500 -3750  -2500 3750))
      (pin USB "1" 0 1300)
      (pin USB "2" 0 650)
      (pin USB "3" 0 0)
      (pin USB "4" 0 -650)
      (pin USB "5" 0 -1300)
    )
    (image "Package_TO_SOT_SMD:SOT-223::U2"
      (outline (path signal 50  -3250 1750  3250 1750  3250 -1750  -3250 -1750  -3250 1750))
      (pin SOT_PIN "1" -2300 -3100)
      (pin SOT_PIN "2" 0 -3100)
      (pin SOT_PIN "3" 2300 -3100)
      (pin SOT_TAB "4" 0 3100)
    )
    (image "MountingHole:MountingHole_3.2mm_M3_Pad::H1"
      (outline (path signal 50  -2800 2800  2800 2800  2800 -2800  -2800 -2800  -2800 2800))
