LOCATE COMP "clk" SITE "G2";
IOBUF PORT "clk" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25 MHZ;
LOCATE COMP "led[0]" SITE "B2"; LOCATE COMP "led[1]" SITE "C2";
LOCATE COMP "led[2]" SITE "C1"; LOCATE COMP "led[3]" SITE "D2";
LOCATE COMP "led[4]" SITE "D1"; LOCATE COMP "led[5]" SITE "E2";
LOCATE COMP "led[6]" SITE "E1"; LOCATE COMP "led[7]" SITE "H3";
IOBUF PORT "led[0]" IO_TYPE=LVCMOS33;
