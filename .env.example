# Copy to .env (gitignored). Single-quote values: keys may contain '$' or '/'.
CRUSOE_API_KEY='...'
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
CRUSOE_DEFAULT_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# Bearer token clients must send to the MCP server (python -c "import secrets;print(secrets.token_urlsafe(32))")
MANUDESK_TOKEN='...'
# Optional: OSS CAD Suite bin dir and scratch dir (no spaces)
# MANUDESK_TOOLS=/opt/fpga/oss-cad-suite/bin
# MANUDESK_WORK=/var/tmp/manudesk
