      "name": "latency+1",
      "find": "localparam LATENCY = 2;",
      "replace": "localparam LATENCY = 3;"
    },
    {
      "name": "wrong-init",
      "find": "crc_r  <= 32'hFFFFFFFF;",
      "replace": "crc_r  <= 32'hFFFFFFFE;"
    }
  ]
